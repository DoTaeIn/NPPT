{
  "name": "@marco/ai",
  "version": "0.0.1",
  "private": true,
  "description": "MARCO prompt kit and vendor-neutral authoring pipeline (outline → slides → notes → revise)",
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "prompts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsx scripts/build-kit.ts",
    "kit": "tsx scripts/build-kit.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.dev.json",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@marco/schema": "workspace:*",
    "yaml": "^2.9.1"
  }
}
