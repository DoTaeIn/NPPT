{
  "name": "@marco/mcp",
  "version": "0.0.1",
  "private": true,
  "description": "MARCO Engine MCP server: lets AI applications build, lint and scaffold lecture decks as tools",
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "marco-mcp": "./dist/main.js" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }, "./package.json": "./package.json" },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@marco/schema": "workspace:*",
    "@marco/compiler": "workspace:*",
    "@marco/importer": "workspace:*",
    "@marco/ai": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.6.5"
  }
}
