{
  "name": "@marco/cli",
  "version": "0.0.1",
  "private": true,
  "description": "marco CLI: new | build | watch | lint | pdf | import | ai",
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "bin": {
    "marco": "./dist/main.js"
  },
  "dependencies": {
    "@marco/schema": "workspace:*",
    "@marco/compiler": "workspace:*",
    "@marco/importer": "workspace:*",
    "@marco/ai": "workspace:*",
    "commander": "^15.0.0",
    "@marco/mcp": "workspace:*"
  }
}
